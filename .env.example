# Oakly backend configuration. Copy to .env and fill in real values.
# NEVER commit .env. Placeholder values below are not secrets.

# --- Required (the app refuses to start without these) -----------------------
# Local docker compose stack uses the bundled db service:
DATABASE_URL=postgresql://oakly:oakly@db:5432/oakly
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
# Fernet key(s), comma-separated; the first encrypts, all decrypt (for rotation).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VITALS_ENCRYPTION_KEY=change-me

# --- App ---------------------------------------------------------------------
ENVIRONMENT=development
PROJECT_NAME=Oaklycare
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# JSON list or comma-separated origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
FRONTEND_URL=https://www.oaklycare.com

# --- Email (SMTP over SSL) ---------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_TLS=True
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=change-me
EMAILS_FROM_EMAIL=no-reply@example.com
EMAILS_FROM_NAME=Oaklycare
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=5
EMAIL_RESET_TOKEN_EXPIRE_HOURS=24

# --- Paystack ----------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_change-me
PAYSTACK_PUBLIC_KEY=pk_test_change-me
PAYSTACK_WEBHOOK_SECRET=change-me
PAYMENT_CALLBACK_URL=https://www.oaklycare.com/payment/callback
PAYMENT_CURRENCY=NGN
MIN_DEPOSIT_AMOUNT=100
MAX_DEPOSIT_AMOUNT=1000000

# --- Background jobs (ARQ worker) and dispatch ------------------------------
# docker compose overrides REDIS_URL for the worker (redis://redis:6379/0).
# Run the worker locally with: arq app.worker.WorkerSettings
# Redis password (required in production; dev compose defaults to oakly-dev-redis).
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@localhost:6379/0
PAYMENT_LINK_TTL_MINUTES=30
LOCATION_FRESHNESS_MINUTES=15
LATE_PAYMENT_REINSTATE_MIN_LEAD_MINUTES=60
MATCH_RADIUS_KM=20
DISPATCH_WAVE_SIZE=8
DISPATCH_WAVE_MINUTES=10
DISPATCH_ESCALATE_MINUTES=30

# --- Caregiver app: push (Expo), visit code, home ----------------------------
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
# EXPO_PUSH_TIMEOUT_SECONDS=5
# Only when "enhanced push security" is enabled for the Expo project:
# EXPO_ACCESS_TOKEN=
# VISIT_CODE_MAX_ATTEMPTS=3
# VISIT_CODE_LOCK_MINUTES=15
# HOME_TIMEZONE=Africa/Lagos

# --- WhatsApp patient channel (Meta Cloud API) -------------------------------
# Empty app secret or verify token = the webhook refuses everything (fail closed).
# Values come from the Meta developer app (App settings > Basic > App secret; WhatsApp > API setup).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
# Any random string you choose; paste the same value into the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_GRAPH_URL=https://graph.facebook.com
# WHATSAPP_GRAPH_VERSION=v23.0
# WHATSAPP_HTTP_TIMEOUT_SECONDS=5
# WHATSAPP_MAX_SEND_ATTEMPTS=3
# WHATSAPP_RETRY_BACKOFF_SECONDS=0.5
# Recorded on every consent; bump it when the privacy notice changes.
# WHATSAPP_POLICY_VERSION=2026-10-01
# WHATSAPP_PRIVACY_POLICY_URL=https://www.oaklycare.com/privacy
# Comma-separated numbers in the emergency reply. Add state lines only once verified.
# WHATSAPP_EMERGENCY_NUMBERS=112
# Optional phone line offered to someone who declines consent.
# WHATSAPP_SUPPORT_PHONE=
# Booking in chat (W2). Empty flow id = "Book a visit" hands over to a person.
# The id is shown in Meta's Flow builder after uploading app/channels/whatsapp/flows/booking.json.
WHATSAPP_BOOKING_FLOW_ID=
# The Flow data endpoint's RSA private key (PEM), kept on one line with the newlines written as \n.
# Upload the matching public key to Meta (see the booking SOP). Never commit a real key.
WHATSAPP_FLOW_PRIVATE_KEY=
# WHATSAPP_FLOW_PRIVATE_KEY_PASSPHRASE=
# Optional. A WhatsApp booking with no location pin gets its typed address geocoded (street and city only, never
# health data). Empty = off: the booking keeps the city-centre placeholder and is held for an address check.
# GOOGLE_MAPS_API_KEY=
# GEOCODING_TIMEOUT_SECONDS=3
# WHATSAPP_SERVICE_CITIES=Lagos,Abuja
# WHATSAPP_SERVICE_MAX_HOURS=nurse:12,caregiver:24,physiotherapist:4,doctor:2,nutritionist:2
# WHATSAPP_QUOTE_TTL_MINUTES=30
# WHATSAPP_IDLE_EXPIRY_MINUTES=30
# WHATSAPP_PAYMENT_REMINDER_MINUTES=20
# Cancellation fee tiers and drop-out timings live in the database: admin console, /admin/booking-policy.
# WHATSAPP_PAYMENT_RETURN_URL=https://www.oaklycare.com/pay/return
# Only the local end-to-end script changes this (it points the API at a fake Paystack).
# PAYSTACK_BASE_URL=https://api.paystack.co

# --- Gemini (AI insights) ----------------------------------------------------
GEMINI_API_KEY=change-me

# --- Cloudinary (profile images) ---------------------------------------------
CLOUDINARY_CLOUD_NAME=change-me
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me

# --- Caregiver KYC (Prembly) -----------------------------------------------
# In production the app REFUSES TO BOOT unless PREMBLY_WEBHOOK_KEY, PREMBLY_SECRET_KEY and KYC_FINGERPRINT_KEY are set.
# The webhook URL to register in the Prembly dashboard is <API base>/api/v1/kyc/prembly/webhook.
# PREMBLY_BASE_URL=https://api.prembly.com
# PREMBLY_SECRET_KEY=
# PREMBLY_ORG_ID=
# PREMBLY_WIDGET_ID=
# PREMBLY_WIDGET_KEY=
# PREMBLY_WEBHOOK_KEY=
# KYC_FINGERPRINT_KEY=
# KYC_MAX_ATTEMPTS=3
# KYC_SESSION_TTL_HOURS=24
# KYC_FACE_THRESHOLD=85
# KYC_FACE_FLOOR=70
# KYC_LIVENESS_FLOOR=50
# KYC_ALERT_EMAIL=
# KYC_POLICY_VERSION=kyc-2026-10

# --- Optional / not yet used -------------------------------------------------
# FCM_SERVER_KEY=
# APNS_KEY_ID=
# APNS_TEAM_ID=

# --- Reverse proxy -----------------------------------------------------------
# Comma-separated CIDRs of reverse proxies in front of the API (e.g. 172.18.0.0/16 for a Docker
# network nginx). Empty = trust no proxy headers (correct when clients connect directly).
# MUST be set in production behind a proxy, or all clients share one IP for rate limiting.
TRUSTED_PROXIES=
