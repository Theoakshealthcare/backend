{
  "request": {
    "method": "POST",
    "path": "/api/v1/admin/care-alerts/<ALERT_ID>/resolve",
    "auth": "Bearer <ADMIN_ACCESS_TOKEN_JWT>",
    "body": {
      "note": "<1001 characters>"
    }
  },
  "response": {
    "status_code": 422,
    "body": {
      "detail": [
        {
          "type": "string_too_long",
          "loc": [
            "body",
            "note"
          ],
          "msg": "String should have at most 1000 characters",
          "ctx": {
            "max_length": 1000
          }
        }
      ]
    }
  }
}
