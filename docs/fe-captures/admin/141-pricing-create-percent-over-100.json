{
  "request": {
    "method": "POST",
    "path": "/api/v1/booking-settings/",
    "auth": "Bearer <ACCESS_TOKEN_JWT>",
    "body": {
      "base_fee": 5000,
      "platform_fee_percent": 150,
      "multipliers": {
        "nurse": 1.0,
        "doctor": 2.0
      },
      "surge_pricing": false,
      "surge_multiplier": 1.0,
      "discount": 0,
      "reason": "Opening price list"
    }
  },
  "response": {
    "status_code": 422,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "detail": [
        {
          "type": "less_than_equal",
          "loc": [
            "body",
            "platform_fee_percent"
          ],
          "msg": "Input should be less than or equal to 100",
          "input": 150,
          "ctx": {
            "le": 100.0
          }
        }
      ]
    }
  }
}
