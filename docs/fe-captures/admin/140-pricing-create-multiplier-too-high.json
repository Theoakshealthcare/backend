{
  "request": {
    "method": "POST",
    "path": "/api/v1/booking-settings/",
    "auth": "Bearer <ACCESS_TOKEN_JWT>",
    "body": {
      "base_fee": 5000,
      "platform_fee_percent": 10,
      "multipliers": {
        "nurse": 150
      },
      "surge_pricing": false,
      "surge_multiplier": 1.0,
      "discount": 0,
      "reason": "Opening price list"
    }
  },
  "response": {
    "status_code": 422,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "detail": [
        {
          "type": "value_error",
          "loc": [
            "body",
            "multipliers"
          ],
          "msg": "Value error, nurse: must be above 0 and at most 10",
          "input": {
            "nurse": 150
          },
          "ctx": {
            "error": {}
          }
        }
      ]
    }
  }
}
