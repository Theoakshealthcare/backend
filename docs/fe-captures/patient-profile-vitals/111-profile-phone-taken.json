{
  "request": {
    "method": "PUT",
    "path": "/auth/profile",
    "auth": "Bearer <ACCESS_TOKEN_JWT>",
    "body": {
      "phone_number": "+2348030000202"
    }
  },
  "response": {
    "status_code": 409,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "detail": {
        "code": "phone_number_taken",
        "message": "That phone number is already used by another account."
      }
    }
  },
  "note": "The phone belongs to another account."
}
