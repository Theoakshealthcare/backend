{
  "request": {
    "method": "POST",
    "path": "/api/v1/caregiver/availability",
    "auth": "Bearer <ACCESS_TOKEN_JWT>",
    "body": {
      "is_available": true
    }
  },
  "response": {
    "status_code": 409,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "detail": "Share your location before going available"
    }
  }
}
