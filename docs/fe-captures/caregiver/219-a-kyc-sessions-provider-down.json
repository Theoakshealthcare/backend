{
  "request": {
    "method": "POST",
    "path": "/api/v1/caregiver/identity-verification/sessions",
    "auth": "Bearer <ACCESS_TOKEN_JWT>",
    "body": {
      "consent": true,
      "policy_version": "kyc-2026-10"
    }
  },
  "response": {
    "status_code": 503,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "detail": {
        "code": "PROVIDER_UNAVAILABLE",
        "message": "Identity verification is temporarily unavailable. Please try again later."
      }
    }
  }
}
