{
  "request": {
    "method": "PUT",
    "path": "/api/v1/caregiver/profile/step2",
    "auth": "Bearer <ACCESS_TOKEN_JWT>",
    "body": {
      "specialization": "Elderly Care",
      "years_of_experience": 5,
      "preferred_work_hours": "weekdays",
      "service_areas": [
        "Personal Care",
        "Medication Reminders"
      ]
    }
  },
  "response": {
    "status_code": 422,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "detail": [
        {
          "type": "missing",
          "loc": [
            "body",
            "applying_as"
          ],
          "msg": "Field required",
          "input": null
        }
      ]
    }
  },
  "note": "A first submission of step 2 without applying_as is refused (the same 'missing' error as any other required field) and nothing is saved."
}
