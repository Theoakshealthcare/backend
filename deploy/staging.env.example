# Oakly backend: STAGING environment file (template).
#
# Copy to /etc/oakly/staging.env on the server and fill every CHANGE_ME. Never commit the filled file
# (chmod 600, owner root). Every value below is a placeholder; none is a real secret.
#
# How the file is used:
#   * docker-compose.staging.yml passes it to the api and worker containers (`env_file`) and reads
#     POSTGRES_PASSWORD / REDIS_PASSWORD from it to build DATABASE_URL and REDIS_URL.
#   * The app (app/core/config.py, `Settings`) REFUSES UNKNOWN KEYS when it loads a .env FILE, so a
#     misspelled key stops the app booting. Inside the containers the values arrive as process
#     environment, where an unknown name is ignored: POSTGRES_PASSWORD is the one compose-only key here.
#     app/tests/test_staging_env_example.py keeps this file in step with Settings (every setting is
#     named below, active or commented out).
#   * A line that starts with "# KEY=" is a setting left at its code default (or off). Uncomment to change.
#
# Legend for each group: REQUIRED = the app will not boot or the feature is dead without it on staging;
# NEEDED FOR <feature> = boots without it but that feature does not work; OPTIONAL = a default is fine.
#
# Runbook: docs/deploy/staging.md. Generate secrets with the commands in the comments (they print the value
# once to YOUR terminal: paste it into the file, never into chat, tickets or git).

# ============================================================================
# 1. CORE AND COMPOSE-ONLY
# ============================================================================

# REQUIRED. Anything except "development" (development starts uvicorn with --reload). "staging" lets the app boot before
# Dojah and the KYC widget URL exist. Switch to "production" for the pre-launch rehearsal: the app then REFUSES to boot
# without PAYSTACK_SECRET_KEY, DOJAH_WEBHOOK_SECRET, DOJAH_SECRET_KEY, KYC_FINGERPRINT_KEY and an https
# KYC_WIDGET_PUBLIC_BASE_URL, pins PAYSTACK_BASE_URL to api.paystack.co and drops the exp:// KYC return schemes.
ENVIRONMENT=staging

# OPTIONAL. The API prefix. The apps, nginx and the smoke script all assume /api/v1: do not change it.
# API_V1_STR=/api/v1

# OPTIONAL. Shown in email subjects and as the default sender name.
PROJECT_NAME=Oaklycare

# COMPOSE-ONLY (not a Settings key). REQUIRED. The Postgres password; compose builds DATABASE_URL from it.
# Must be URL-safe: `openssl rand -hex 24`. Set it BEFORE the first `up`: Postgres bakes it into the data volume.
POSTGRES_PASSWORD=CHANGE_ME_hex48

# REQUIRED (declared in Settings so this file loads). Redis password; compose builds REDIS_URL from it.
# URL-safe: `openssl rand -hex 24`.
REDIS_PASSWORD=CHANGE_ME_hex48

# SET BY COMPOSE (docker-compose.staging.yml `environment` wins over this file): leave it out. It is
# required by Settings, so a bare `Settings()` outside Docker needs it, nothing else.
# DATABASE_URL=postgresql://oakly:<POSTGRES_PASSWORD>@db:5432/oakly

# SET BY COMPOSE: leave it out (see DATABASE_URL).
# REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0

# ============================================================================
# 2. SECRETS AND SESSIONS
# ============================================================================

# REQUIRED. Signs every JWT (app users and admins). `openssl rand -hex 32`. Changing it signs everyone out.
# Use a value different from every other environment.
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32

# REQUIRED, and it must be a REAL Fernet key or `alembic upgrade head` fails with "Fernet key must be 32 url-safe
# base64-encoded bytes". Generate (valid Fernet key, verified):
#     openssl rand -base64 32 | tr '+/' '-_'
# It encrypts health data, voice-note transcripts and the audio parked in Redis. LOSE IT AND THAT DATA IS UNREADABLE:
# copy it into the team password manager at once. Comma-separated list = rotation (first encrypts, all decrypt;
# see scripts/reencrypt_health_data.py).
VITALS_ENCRYPTION_KEY=CHANGE_ME_fernet_key

# REQUIRED in production, set it on staging too. Keys the duplicate-identity hash of a NIN/BVN (empty = a plain hash).
# `openssl rand -hex 32`. Never rotate it casually: it breaks duplicate detection for existing caregivers.
KYC_FINGERPRINT_KEY=CHANGE_ME_openssl_rand_hex_32

# ACCESS_TOKEN_EXPIRE_MINUTES=60

# REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# 3. PUBLIC URLS, CORS AND PROXY (replace staging.example.com with the real domain)
# ============================================================================

# NEEDED FOR the admin web console only (the native apps do not use CORS). Comma-separated or a JSON list of origins,
# no trailing path. Add http://localhost:3001 only while a developer runs the console locally against staging.
BACKEND_CORS_ORIGINS=https://admin.staging.example.com

# REQUIRED for correct rate limits and audit IPs. The compose network subnet (docker-compose.staging.yml): host nginx
# reaches the API through the bridge gateway, and X-Forwarded-For is only believed from a listed peer. If you change the
# subnet in the compose file, change this too.
TRUSTED_PROXIES=172.29.0.0/24

# Where Paystack sends the patient's browser after paying a booking: <FRONTEND_URL>/bookings/<id>/payment-complete.
# The apps do not intercept that URL, and no page exists there yet: a 404 after paying is cosmetic, the webhook is
# what marks the booking paid. Owner decides which domain.
FRONTEND_URL=https://www.staging.example.com

# NEEDED FOR caregiver KYC. The origin a phone reaches this API at: https, no path, no query (the app refuses to boot
# on anything else in production). Same host as the nginx server block.
KYC_WIDGET_PUBLIC_BASE_URL=https://api.staging.example.com

# OPTIONAL. The deep link the KYC page returns to; scheme must be one the caregiver app registers. The default matches
# the caregiver app's scheme. Never a web URL.
# KYC_RETURN_URL=oaklycarecaregivermobile://kyc/return

# OPTIONAL. Return URL for patient wallet deposits (the patient app hides the wallet in v1).
# PAYMENT_CALLBACK_URL=https://www.oaklycare.com/payment/callback

# OPTIONAL. Relative to the image's /app; do not change.
# EMAIL_TEMPLATES_DIR=app/templates/emails

# OPTIONAL. Caregiver documents. Must stay private_uploads: compose mounts a volume on /app/private_uploads.
# PRIVATE_UPLOAD_DIR=private_uploads

# ============================================================================
# 4. EMAIL (sign-up codes, password-reset codes, admin invites)
# NEEDED FOR sign-up and reset. Without SMTP the codes are only written to the API log (no mail is sent, nobody
# sees an error). IMPORTANT: app/services/email.py always connects with IMPLICIT TLS (smtplib.SMTP_SSL), so the
# provider must offer port 465; SMTP_TLS is declared but not read, and STARTTLS on 587 does not work.
# ============================================================================

# NEEDED. Provider host, e.g. smtp.zoho.com / email-smtp.<region>.amazonaws.com / smtp.resend.com.
SMTP_HOST=smtp.CHANGE_ME.example

# NEEDED. Must be an implicit-TLS port (465).
SMTP_PORT=465

# NEEDED. Resend uses the literal user `resend`; Zoho uses the mailbox; SES uses an SMTP credential id.
SMTP_USER=CHANGE_ME_smtp_user

# NEEDED. App password / API key from the provider.
SMTP_PASSWORD=CHANGE_ME_smtp_password

# NEEDED. The From address; its domain must have SPF and DKIM set up with the provider or the codes land in spam.
# Must be a syntactically valid address (the app refuses to boot otherwise).
EMAILS_FROM_EMAIL=noreply@staging.example.com

# OPTIONAL. Falls back to PROJECT_NAME.
EMAILS_FROM_NAME=Oaklycare

# Declared but NOT read by the code (see the section note). Leave it.
# SMTP_TLS=true

# EMAIL_RESET_TOKEN_EXPIRE_HOURS=48

# OTP_EXPIRE_MINUTES=10

# OTP_LENGTH=5

# OPTIONAL. Who is emailed when the Dojah wallet is empty or its key is refused (empty = log only). Needs SMTP.
KYC_ALERT_EMAIL=support@staging.example.com

# ============================================================================
# 5. PAYSTACK (TEST keys on staging; never a live key)
# ============================================================================

# REQUIRED for bookings and payouts. Paystack dashboard > Settings > API Keys & Webhooks, in TEST mode: sk_test_...
# The same key signs the webhook (Paystack signs with the secret key; there is no separate webhook secret).
PAYSTACK_SECRET_KEY=sk_test_CHANGE_ME

# NEEDED. The TEST public key (pk_test_...).
PAYSTACK_PUBLIC_KEY=pk_test_CHANGE_ME

# DECLARED BUT UNUSED: signatures are verified with PAYSTACK_SECRET_KEY. Leave empty.
# PAYSTACK_WEBHOOK_SECRET=

# OPTIONAL. Leave at api.paystack.co (test keys work there). Production refuses anything else.
# PAYSTACK_BASE_URL=https://api.paystack.co

# PAYMENT_CURRENCY=NGN

# MAX_DEPOSIT_AMOUNT=1000000

# MIN_DEPOSIT_AMOUNT=100

# MIN_WITHDRAWAL_KOBO=100000

# OPTIONAL. Keep false in v1 (refunds go to the original payment method).
# REFUND_WALLET_CREDIT_ENABLED=false

# PAYMENT_LINK_TTL_MINUTES=30

# LATE_PAYMENT_REINSTATE_MIN_LEAD_MINUTES=60

# ============================================================================
# 6. DOJAH (caregiver KYC; SANDBOX on staging)
# NEEDED FOR the caregiver identity step. Empty = the start endpoint answers 503 and the ops alert fires; nothing else breaks.
# Dojah dashboard values; webhook URL to register: https://api.<domain>/api/v1/kyc/dojah/webhook
# ============================================================================

# NEEDED for test_ keys: the live host (https://api.dojah.io) answers 401 to them.
DOJAH_BASE_URL=https://sandbox.dojah.io

# NEEDED. Public (the API hands it to the app).
DOJAH_APP_ID=CHANGE_ME_dojah_app_id

# NEEDED. Public key (test_pk_...).
DOJAH_PUBLIC_KEY=test_pk_CHANGE_ME

# NEEDED. SECRET key (test_sk_...). Server only.
DOJAH_SECRET_KEY=test_sk_CHANGE_ME

# NEEDED. The sandbox widget's id.
DOJAH_WIDGET_ID=CHANGE_ME_dojah_widget_id

# NEEDED. The "Secret" you type when you create the webhook in the Dojah dashboard (NOT the API secret key).
# Generate one: `openssl rand -hex 32`, put it here AND in the dashboard.
DOJAH_WEBHOOK_SECRET=CHANGE_ME_dojah_webhook_secret

# DOJAH_FACE_MATCH_THRESHOLD=70

# KYC_MAX_ATTEMPTS=3

# KYC_SESSION_TTL_HOURS=24

# KYC_FACE_THRESHOLD=85

# KYC_FACE_FLOOR=70

# UNUSED since Dojah; kept so an env file that sets it still loads.
# KYC_LIVENESS_FLOOR=50

# KYC_POLICY_VERSION=kyc-2026-10

# ============================================================================
# 7. GEMINI AND AI VOICE NOTES
# ============================================================================

# NEEDED FOR FallGuard advice and voice-note transcription. Google AI Studio key (a paid, non-training tier before real
# patient audio). The FallGuard model is fixed in code (app/services/gemini.py); there is NO GEMINI_MODEL setting on
# main, and setting one stops the app booting. Voice notes use VOICE_NOTE_MODEL below.
GEMINI_API_KEY=CHANGE_ME_gemini_api_key

# Keep false for the first deploy; also the kill switch (restart api + worker after changing it). Turn it on only after a
# phone has sent a real push and a real recording has been transcribed (docs/deploy/staging.md, section 13).
VOICE_NOTES_ENABLED=false

# VOICE_NOTE_MODEL=gemini-2.5-flash

# VOICE_NOTE_MIN_SECONDS=2

# VOICE_NOTE_MAX_SECONDS=600

# VOICE_NOTE_MAX_BYTES=12582912

# VOICE_NOTE_MAX_PER_BOOKING=20

# VOICE_NOTE_MAX_PER_CAREGIVER_PER_DAY=30

# The owner sets the real daily audio budget (all users, per UTC day) before switching on.
# VOICE_NOTE_DAILY_AUDIO_SECONDS_CAP=36000

# VOICE_NOTE_MAX_CONCURRENT=2

# VOICE_NOTE_AUDIO_TTL_SECONDS=1800

# VOICE_NOTE_DRAFT_TTL_HOURS=24

# Proposed 365; the owner and counsel decide.
# VOICE_NOTE_RETENTION_DAYS=365

# VOICE_NOTE_POST_VISIT_GRACE_MINUTES=120

# VOICE_NOTE_EDIT_WINDOW_HOURS=24

# VOICE_NOTE_PROVIDER_TIMEOUT_SECONDS=90

# ============================================================================
# 8. PUSH NOTIFICATIONS
# Push goes through EXPO's push service. The backend needs NO Firebase or Apple secret: the FCM Admin SDK key is
# uploaded to Expo with `eas credentials` (docs/deploy/staging.md, section 11), not to this file. The server only
# needs outbound HTTPS to exp.host.
# ============================================================================

# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# EXPO_PUSH_TIMEOUT_SECONDS=5

# OPTIONAL. Only if "enhanced push security" is switched on in the Expo project; then a token from expo.dev.
# EXPO_ACCESS_TOKEN=

# DECLARED BUT UNUSED by the code (push uses Expo). Leave empty; do not put the Admin SDK key here.
# FCM_SERVER_KEY=

# DECLARED BUT UNUSED (push uses Expo). Leave empty.
# APNS_KEY_ID=

# DECLARED BUT UNUSED (push uses Expo). Leave empty.
# APNS_TEAM_ID=

# ============================================================================
# 9. CLOUDINARY (profile photos)
# ============================================================================

# NEEDED FOR profile-photo upload (POST /auth/profile/upload-image). Use a staging Cloudinary account/folder, not production.
CLOUDINARY_CLOUD_NAME=CHANGE_ME_cloud_name

# NEEDED FOR profile-photo upload.
CLOUDINARY_API_KEY=CHANGE_ME_cloudinary_key

# NEEDED FOR profile-photo upload.
CLOUDINARY_API_SECRET=CHANGE_ME_cloudinary_secret

# ============================================================================
# 10. MAPS AND GEOCODING
# ============================================================================

# OPTIONAL. Only for geocoding typed WhatsApp addresses (parked). Empty = off.
# GOOGLE_MAPS_API_KEY=

# GEOCODING_TIMEOUT_SECONDS=3.0

# ============================================================================
# 11. WHATSAPP PATIENT CHANNEL (PARKED: leave all of this empty)
# Blocked on Meta business verification. Empty app secret / verify token = the webhook refuses every request (fail closed),
# which is what staging wants. Webhook path when it is enabled: /api/v1/whatsapp/webhook.
# ============================================================================

# WHATSAPP_PHONE_NUMBER_ID=

# WHATSAPP_ACCESS_TOKEN=

# WHATSAPP_APP_SECRET=

# WHATSAPP_VERIFY_TOKEN=

# WHATSAPP_BOOKING_FLOW_ID=

# WHATSAPP_FLOW_PRIVATE_KEY=

# WHATSAPP_FLOW_PRIVATE_KEY_PASSPHRASE=

# WHATSAPP_SUPPORT_PHONE=

# WHATSAPP_GRAPH_URL=https://graph.facebook.com

# WHATSAPP_GRAPH_VERSION=v23.0

# WHATSAPP_HTTP_TIMEOUT_SECONDS=5

# WHATSAPP_MAX_SEND_ATTEMPTS=3

# WHATSAPP_RETRY_BACKOFF_SECONDS=0.5

# WHATSAPP_POLICY_VERSION=2026-10-01

# WHATSAPP_PRIVACY_POLICY_URL=https://www.oaklycare.com/privacy

# WHATSAPP_BODY_TTL_SECONDS=21600

# WHATSAPP_EMERGENCY_NUMBERS=112

# WHATSAPP_SERVICE_CITIES=Lagos,Abuja

# WHATSAPP_SERVICE_MAX_HOURS=nurse:12,caregiver:24,physiotherapist:4,doctor:2,nutritionist:2

# WHATSAPP_DEFAULT_MAX_HOURS=8

# WHATSAPP_QUOTE_TTL_MINUTES=30

# WHATSAPP_IDLE_EXPIRY_MINUTES=30

# WHATSAPP_PAYMENT_REMINDER_MINUTES=20

# WHATSAPP_MIN_LEAD_HOURS=2

# WHATSAPP_SLOT_START_HOUR=7

# WHATSAPP_SLOT_END_HOUR=20

# WHATSAPP_MAX_RECIPIENTS=10

# WHATSAPP_PAYMENT_RETURN_URL=https://www.oaklycare.com/pay/return

# ============================================================================
# 12. OPERATIONAL TUNABLES (code defaults; leave commented unless the owner asks for a change)
# ============================================================================

# HOME_TIMEZONE=Africa/Lagos

# LOCATION_FRESHNESS_MINUTES=15

# MATCH_RADIUS_KM=20

# DISPATCH_WAVE_SIZE=8

# DISPATCH_WAVE_MINUTES=10

# UNMATCHED_SLA_MINUTES=30

# NO_SHOW_GRACE_MINUTES=15

# DISPATCH_ESCALATE_MINUTES=30

# VISIT_CODE_MAX_ATTEMPTS=3

# VISIT_CODE_LOCK_MINUTES=15

# Set false once the old caregiver build (which pastes the long token) is retired.
# PASSWORD_RESET_LEGACY_TOKEN_ENABLED=true

# PASSWORD_RESET_CODE_EXPIRE_MINUTES=15

# PASSWORD_RESET_CODE_MAX_ATTEMPTS=5

# PASSWORD_RESET_CODE_MAX_ATTEMPTS_PER_DAY=20

# PASSWORD_RESET_REQUESTS_PER_HOUR=3

# CHANGE_PASSWORD_FREE_ATTEMPTS=5

# CHANGE_PASSWORD_BACKOFF_SECONDS=30

# CHANGE_PASSWORD_BACKOFF_MAX_SECONDS=900

# ============================================================================
# 13. ADMIN CONSOLE AUTH
# ============================================================================

# OPTIONAL. The name an authenticator app shows. Staging suggestion: Oakly Admin (staging), so it is told apart from production.
# ADMIN_TOTP_ISSUER=Oakly Admin

# ADMIN_ACCESS_TOKEN_MINUTES=15

# ADMIN_MFA_TOKEN_MINUTES=5

# ADMIN_IDLE_TIMEOUT_MINUTES=30

# ADMIN_SESSION_MAX_HOURS=12

# ADMIN_INVITE_HOURS=48

# ADMIN_MAX_FAILED_LOGINS=10

# ADMIN_LOCKOUT_TIERS_MINUTES=15,60,1440

# ADMIN_PASSWORD_FREE_ATTEMPTS=5

# ADMIN_PASSWORD_BACKOFF_SECONDS=30

# ADMIN_PASSWORD_BACKOFF_MAX_SECONDS=900

# ADMIN_AUTH_IP_LIMIT=30

# ADMIN_AUTH_IP_WINDOW_SECONDS=60
